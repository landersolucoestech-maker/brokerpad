{
  "name": "brokerpad",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "python3 tools/build_static.py",
    "preview": "vite preview --host 0.0.0.0",
    "verify:source": "python3 tools/materialize_source.py --verify-only",
    "materialize:source": "python3 tools/materialize_source.py",
    "lint": "node tools/check-js.mjs && python3 tools/ui_audit.py --check && python3 tools/domain_audit.py",
    "typecheck": "node tools/check-js.mjs",
    "test": "python3 tools/ui_audit.py --check && python3 tools/domain_audit.py",
    "test:visual": "playwright test",
    "verify": "npm run verify:source && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "vite": "^7.1.0"
  }
}
